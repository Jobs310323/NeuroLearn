# --- База данных (Neon Postgres) ---
# Pooler-строка подходит и для рантайма, и для миграций (драйвер neon-serverless).
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# --- Аутентификация (Auth.js v5) ---
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
# Личный режим: один пользователь, вход по паролю из переменной окружения.
AUTH_OWNER_EMAIL=
AUTH_OWNER_PASSWORD=
AUTH_OWNER_NAME=
# Опционально: GitHub OAuth (включается автоматически, если обе переменные заданы).
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# --- AI ---
# Реестр провайдеров — src/lib/ai/model-adapter.ts.
#
# AI_PROVIDER можно не задавать: основным станет первый провайдер с ключом
# в порядке deepseek, groq, together, mistral, openrouter, google. Так одна и
# та же сборка работает локально и на Vercel, где заданы разные ключи.
# Явное значение главнее автоопределения.
AI_PROVIDER=

# Хотя бы один ключ обязателен. Где брать — README, раздел «Ручные настройки».
# Платный, тариф с предоплатой (не бесплатный, вопреки частому заблуждению):
DEEPSEEK_API_KEY=
# Бесплатный тариф, очень быстрый. Структурированный вывод держит только линейка gpt-oss.
GROQ_API_KEY=
# Самый быстрый инференс, но счёт аккаунта надо активировать: без этого любая
# модель отвечает `Payment Required`, хотя список моделей отдаётся.
CEREBRAS_API_KEY=
TOGETHER_API_KEY=
# Бесплатный тариф (experiment); mistral-large/medium/small проверены и работают.
MISTRAL_API_KEY=
# Бесплатные модели с суффиксом :free.
OPENROUTER_API_KEY=
# Google AI Studio: бесплатный тариф Gemini. В ряде стран недоступен.
GOOGLE_GENERATIVE_AI_API_KEY=

# Модели по агентам. Формат — `провайдер:модель` (`groq:openai/gpt-oss-120b`).
# Строка без известного префикса считается моделью основного провайдера.
# Проверить, что модель вообще отвечает: npm run test:models -- <ссылка>
AI_MODEL_CONTENT_GENERATOR=
AI_MODEL_TUTOR=
AI_MODEL_PROGRESS_ANALYZER=
AI_MODEL_METACOGNITIVE_COACH=

# Резерв circuit breaker'а (src/lib/ai/resilient-model.ts), через запятую,
# по убыванию приоритета. Пусто НЕ значит «резерва нет»: цепочка соберётся
# сама из всех настроенных провайдеров, кроме основного. Заполнять стоит,
# только если нужен другой порядок или другие модели.
#
# Проверено 2026-08-17 скриптом npm run test:providers:
#   groq:openai/gpt-oss-120b        отвечает,  ~1,5 с
#   groq:openai/gpt-oss-20b         отвечает,  ~0,8 с
#   mistral:mistral-large-latest    отвечает,  ~3,2 с
#   mistral:mistral-small-latest    отвечает,  ~2,8 с
#   openrouter:nvidia/nemotron-3-super-120b-a12b:free  отвечает, ~7-16 с
#   groq:qwen/qwen3.6-27b           НЕ годится: «Failed to validate JSON»
#   groq:groq/compound              НЕ годится: не поддерживает json_schema
#
# Отдельно для тьютора: ему нужен toolChoice='required', которого gpt-oss-20b
# на OpenRouter не поддерживает (400 "inference-enforced tool_choice is not
# supported"), — в AI_MODEL_TUTOR_FALLBACKS эта модель не годится.
AI_MODEL_CONTENT_GENERATOR_FALLBACKS=
AI_MODEL_TUTOR_FALLBACKS=
AI_MODEL_PROGRESS_ANALYZER_FALLBACKS=
AI_MODEL_METACOGNITIVE_COACH_FALLBACKS=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Заголовок Authorization: Bearer <CRON_SECRET> на /api/cron/* (Vercel Cron шлёт его сам,
# при локальном вызове — вручную). Сгенерировать так же, как AUTH_SECRET.
# ОБЯЗАТЕЛЕН в production: без него эндпоинт отвечает 500.
CRON_SECRET=

# Rate limit на AI-роутах (src/lib/security/rate-limit.ts): /api/tutor/chat и защита
# проекта — 20/мин, /api/ai/generate/{tree,module} — 5/час.
# ОБЯЗАТЕЛЬНЫ в production: без них роуты отвечают ошибкой, а не пропускают молча.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Осознанный отказ от лимита (например, установка на одного человека).
# Значение 1 отменяет требование выше.
RATE_LIMIT_DISABLED=

# Доступ к Management API Upstash для `npm run setup:upstash` — он показывает
# базы аккаунта и печатает готовые строки для двух переменных выше.
# Это НЕ ключ базы: выпускается в консоли, Account -> Management API.
# Почта обязательна: авторизация идёт парой «почта:ключ», и с чужой почтой
# верный ключ отвечает 401.
UPSTASH_EMAIL=
UPSTASH_MANAGEMENT_API_KEY=

# Вебхук для критичных ошибок (src/lib/monitoring/logger.ts): Slack/Telegram/что угодно,
# принимающее POST с JSON `{ text }`. Пусто — ошибки только в лог рантайма.
# Проверить канал: npm run test:alert
ALERT_WEBHOOK_URL=

# Внешний трекинг ошибок (src/lib/monitoring/tracker.ts). Формат DSN
# Sentry/GlitchTip: https://<publicKey>@<host>/<projectId>. Пусто — трекинг
# выключён честно: состояние видно в /settings, ошибки остаются в логах.
# Наружу уходят только тип ошибки, сообщение и стек — учебные данные (ответы,
# заметки, рефлексии) туда не попадают.
ERROR_TRACKING_DSN=
# Метка окружения в событиях. По умолчанию берётся NODE_ENV.
ERROR_TRACKING_ENVIRONMENT=

# Web Push напоминания об отложенных повторениях. Сгенерировать пару:
# npm run generate:vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: адрес, по которому push-сервисы могут связаться при проблемах с рассылкой.
VAPID_SUBJECT=
# Тот же публичный ключ, но виден в браузере (нужен на клиенте для PushManager.subscribe).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Понижает порог логов повторений, после которого cron взводит флаг
# переоптимизации весов FSRS (по умолчанию 200). Только для проверки пути
# целиком — в рабочей установке переменной быть не должно.
FSRS_TEST_THRESHOLD=

# --- Сеть ---
# Node не читает эти переменные сам (в отличие от curl, git и npm), поэтому
# приложение включает поддержку явно — src/lib/net/proxy.ts. Если выход в
# интернет идёт через локальный прокси, без этого вызовы к провайдерам моделей
# уходят напрямую и возвращают 403, что выглядит как блокировка на их стороне.
# На Vercel переменные не нужны.
HTTPS_PROXY=
HTTP_PROXY=
