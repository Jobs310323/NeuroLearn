# --- База данных (Neon Postgres) ---
# Pooler-строка подходит и для рантайма, и для миграций (драйвер neon-serverless).
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# --- Аутентификация (Auth.js v5) ---
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
# Личный режим: один пользователь, вход по паролю из переменной окружения.
AUTH_OWNER_EMAIL=
AUTH_OWNER_PASSWORD=
AUTH_OWNER_NAME=
# Опционально: GitHub OAuth (включается автоматически, если обе переменные заданы).
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# --- AI ---
# Провайдер: openrouter | google | anthropic
AI_PROVIDER=openrouter
# OpenRouter: бесплатные модели доступны с обычным ключом (модели с суффиксом :free).
OPENROUTER_API_KEY=
# Google AI Studio: бесплатный тариф Gemini.
GOOGLE_GENERATIVE_AI_API_KEY=
# Anthropic напрямую (платно) — задел на будущее.
ANTHROPIC_API_KEY=

# Модели по агентам. Значения по умолчанию — бесплатные.
# Для перехода на платные достаточно поменять здесь идентификаторы.
AI_MODEL_CONTENT_GENERATOR=
AI_MODEL_TUTOR=
AI_MODEL_PROGRESS_ANALYZER=
AI_MODEL_METACOGNITIVE_COACH=

# Резервные модели circuit breaker'а (src/lib/ai/resilient-model.ts), через запятую,
# по убыванию приоритета. Пусто = резерва нет, поведение как раньше.
AI_MODEL_CONTENT_GENERATOR_FALLBACKS=
AI_MODEL_TUTOR_FALLBACKS=
AI_MODEL_PROGRESS_ANALYZER_FALLBACKS=
AI_MODEL_METACOGNITIVE_COACH_FALLBACKS=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Заголовок Authorization: Bearer <CRON_SECRET> на /api/cron/* (Vercel Cron шлёт его сам,
# при локальном вызове — вручную). Сгенерировать так же, как AUTH_SECRET.
CRON_SECRET=

# Rate limit на AI-роутах (src/lib/security/rate-limit.ts): /api/tutor/chat и защита
# проекта — 20/мин, /api/ai/generate/{tree,module} — 5/час. Опционально: без
# Upstash-аккаунта лимит просто выключен, приложение работает как раньше.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Вебхук для критичных ошибок (src/lib/monitoring/logger.ts): Slack/Telegram/что угодно,
# принимающее POST с JSON `{ text }`. Пусто — ошибки только в лог рантайма.
ALERT_WEBHOOK_URL=
